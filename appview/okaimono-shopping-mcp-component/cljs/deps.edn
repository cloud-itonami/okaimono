;; Okaimono shopping-mcp appview frontend — reagent + re-frame, rendered with
;; jp-go-dds (デジタル庁デザインシステム). Migrated from
;; appview/okaimono-shopping-mcp-component/svelte (Svelte 5 + SvelteKit +
;; @sveltejs/adapter-cloudflare — two files: App.svelte, a scaffold heading +
;; paragraph, and routes/+page.svelte, which just imported and rendered App).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention — see
;; orgs/kotoba-lang/kami-genko/deps.edn and orgs/kotoba-lang/plm/deps.edn for
;; the same shape: "so library consumers don't inherit reagent/re-frame/
;; shadow-cljs"). jp-go-dds is a workspace git dep and stays top-level.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
