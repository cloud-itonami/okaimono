{
  // NOTE: this app used to be built by SvelteKit's @sveltejs/adapter-cloudflare,
  // which emitted both a server-rendering Worker script (`main`) and a static
  // client bundle (`assets.directory`). The frontend was migrated to a plain
  // ClojureScript (shadow-cljs + reagent + re-frame + jp-go-dds) static bundle
  // with no server-rendering step — see appview/okaimono-shopping-mcp-component/cljs
  // and the repo README's "Deployment" section. `main` is dropped (a Cloudflare
  // Worker can be assets-only) and `assets.directory` now points at the cljs
  // build output. This edit is unverified: `wrangler deploy`/`wrangler dev`
  // were not run against it.
  "name": "kotodama-ok4imn1o",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"e-commerce\",\"product-catalog\"]",
    "APP_DESCRIPTION": "Okaimono — D2C OEM-only AI-operated EC store. Self-branded OEM products manufactured via tsukuru.etzhayyim.com. Catalog, orders, inventory, dynamic pricing, reviews, recommendations, fulfillment, customer support, analytics, and BTO/MTO/CTO manufacturing.",
    "APP_DISPLAY_NAME": "Okaimono D2C Store",
    "APP_EMBED_URL": "https://ok4imn1o.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message",
    "APP_NANOID": "ok4imn1o",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "ok4imn1o.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
